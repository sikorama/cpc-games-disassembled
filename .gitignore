# asm/code/*.asm vs asm/symbols.json, mais ici la source de vérité est
# tools/, pas web/public/)
/knight-lore/web/public/

# Sorties de tools/render_ref.py -- images de contrôle regénérables, jamais commitées
/knight-lore/tools/render_ref_out/
